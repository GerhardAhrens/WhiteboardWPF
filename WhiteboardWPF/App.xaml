<Application
    x:Class="WhiteboardWPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WhiteboardWPF"
    StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--
            Grundfarben der Anwendung.
            Diese werden wir später noch weiter ausbauen.
        -->

        <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#FFF7F7F7" />

        <SolidColorBrush x:Key="BoardBorderBrush" Color="#FFD0D0D0" />

        <SolidColorBrush x:Key="MenuBorderBrush" Color="#FFD0D0D0" />

    </Application.Resources>
</Application>
