<Window
    x:Class="WhiteboardWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WhiteboardWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="900"
    Height="600"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--
            ESC kann später zum Abbrechen einer Aktion
            verwendet werden.
        -->

        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!--  =====================================================  -->
        <!--  Menü  -->
        <!--  =====================================================  -->

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_Datei">

                <MenuItem Click="NewBoard_Click" Header="_Neu" />

                <Separator />

                <MenuItem Click="LoadBoard_Click" Header="Laden" />
                <MenuItem Click="SaveBoard_Click" Header="Speichern" />

                <Separator />

                <MenuItem Click="Exit_Click" Header="_Beenden" />

            </MenuItem>


            <MenuItem Header="_Bearbeiten">

                <MenuItem Click="Delete_Click" Header="_Löschen" />

            </MenuItem>


            <MenuItem Header="_Ansicht">

                <MenuItem Click="ResetBoard_Click" Header="_Whiteboard zurücksetzen" />

            </MenuItem>

        </Menu>


        <!--  =====================================================  -->
        <!--  Statusleiste  -->
        <!--  =====================================================  -->

        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Whiteboard bereit" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem HorizontalContentAlignment="Right">

                <TextBlock Text="WhiteBoard" />

            </StatusBarItem>

        </StatusBar>


        <Border DockPanel.Dock="Left">
            <Grid ColumnDefinitions="40" RowDefinitions="10,35,35,Auto,35,35,35,35,35,35,35,35">
                <Button
                    Grid.Row="1"
                    Width="32"
                    Height="32"
                    Margin="0,0,0,0"
                    Content="A" />

                <Button
                    Grid.Row="2"
                    Width="32"
                    Height="32"
                    Content="B" />

                <Separator
                    Grid.Row="3"
                    Height="10"
                    BorderBrush="Gray" />

                <Button
                    Grid.Row="4"
                    Width="32"
                    Height="32"
                    Content="C" />

                <Button
                    Grid.Row="5"
                    Width="32"
                    Height="32"
                    Content="D" />

                <Button
                    Grid.Row="6"
                    Width="32"
                    Height="32"
                    Content="E" />

                <Button
                    Grid.Row="7"
                    Width="32"
                    Height="32"
                    Content="F" />

                <Button
                    Grid.Row="8"
                    Width="32"
                    Height="32"
                    Content="G" />

                <Button
                    Grid.Row="9"
                    Width="32"
                    Height="32"
                    Content="H" />

                <Button
                    Grid.Row="10"
                    Width="32"
                    Height="32"
                    Content="I" />

                <Button
                    Grid.Row="11"
                    Width="32"
                    Height="32"
                    Content="J" />
            </Grid>
        </Border>

        <!--  =====================================================  -->
        <!--  Whiteboard  -->
        <!--  =====================================================  -->

        <Border
            Margin="8"
            Background="{StaticResource BoardBackgroundBrush}"
            BorderBrush="{StaticResource BoardBorderBrush}"
            BorderThickness="1">

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

                <Canvas
                    x:Name="WhiteBoardCanvas"
                    Width="800"
                    Height="600"
                    Background="{StaticResource BoardBackgroundBrush}"
                    MouseLeftButtonDown="WhiteBoardCanvas_MouseLeftButtonDown"
                    MouseRightButtonDown="WhiteBoardCanvas_MouseRightButtonDown">

                    <Canvas.ContextMenu>

                        <ContextMenu x:Name="WhiteBoardContextMenu" BorderBrush="{StaticResource MenuBorderBrush}">

                            <MenuItem Header="Neues Element">

                                <MenuItem x:Name="ShapeMenu" Header="Shape">

                                    <MenuItem Click="AddRectangle_Click" Header="Rechteck" />

                                    <MenuItem Click="AddRoundedRectangle_Click" Header="Abgerundetes Rechteck" />

                                    <MenuItem Click="AddEllipse_Click" Header="Ellipse" />

                                    <MenuItem Click="AddDiamond_Click" Header="Raute" />

                                </MenuItem>

                                <MenuItem Click="AddText_Click" Header="Text" />

                                <MenuItem Click="AddArrow_Click" Header="Pfeil" />

                                <Separator />

                                <MenuItem Click="AddSymbol_Click" Header="Symbol" />

                            </MenuItem>

                            <Separator />

                            <MenuItem Header="Board">

                                <MenuItem Click="ClearBoard_Click" Header="Board leeren" />

                                <MenuItem Click="ResetBoard_Click" Header="Board zurücksetzen" />

                            </MenuItem>

                            <Separator />

                            <MenuItem Click="CloseContextMenu_Click" Header="Abbrechen" />

                        </ContextMenu>

                    </Canvas.ContextMenu>

                </Canvas>

            </ScrollViewer>

        </Border>

    </DockPanel>
</Window>
