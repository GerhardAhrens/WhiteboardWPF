<Window
    x:Class="WhiteboardWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WhiteboardWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--
            ESC kann später zum Abbrechen einer Aktion
            verwendet werden.
        -->

        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <DockPanel>

    <!-- ===================================================== -->
    <!-- Menü                                                   -->
    <!-- ===================================================== -->

    <Menu DockPanel.Dock="Top">

        <MenuItem Header="_Datei">

            <MenuItem Header="_Neu"
                          Click="NewBoard_Click"/>

            <Separator/>

            <MenuItem Header="_Beenden"
                          Click="Exit_Click"/>

        </MenuItem>


        <MenuItem Header="_Bearbeiten">

            <MenuItem Header="_Löschen"
                          Click="Delete_Click"/>

        </MenuItem>


        <MenuItem Header="_Ansicht">

            <MenuItem Header="_Whiteboard zurücksetzen"
                          Click="ResetBoard_Click"/>

        </MenuItem>

    </Menu>


    <!-- ===================================================== -->
    <!-- Statusleiste                                           -->
    <!-- ===================================================== -->

    <StatusBar DockPanel.Dock="Bottom">

        <StatusBarItem>
            <TextBlock x:Name="StatusText"
                           Text="Whiteboard bereit"/>
        </StatusBarItem>

        <Separator/>

        <StatusBarItem HorizontalContentAlignment="Right">

            <TextBlock Text="WhiteBoard"/>

        </StatusBarItem>

    </StatusBar>


    <!-- ===================================================== -->
    <!-- Whiteboard                                              -->
    <!-- ===================================================== -->

    <Border Margin="8"
                BorderBrush="{StaticResource BoardBorderBrush}"
                BorderThickness="1"
                Background="{StaticResource BoardBackgroundBrush}">

        <Canvas x:Name="WhiteBoardCanvas"
                    Background="{StaticResource BoardBackgroundBrush}"
                    MouseRightButtonDown="WhiteBoardCanvas_MouseRightButtonDown"
                    MouseLeftButtonDown="WhiteBoardCanvas_MouseLeftButtonDown">


            <!-- ================================================= -->
            <!-- Contextmenü                                        -->
            <!-- ================================================= -->

            <Canvas.ContextMenu>

                <ContextMenu x:Name="WhiteBoardContextMenu"
                                 BorderBrush="{StaticResource MenuBorderBrush}">

                    <MenuItem Header="Neues Element">

                        <MenuItem Header="Shape"
                                      Click="AddShape_Click"/>

                        <MenuItem Header="Text"
                                      Click="AddText_Click"/>

                        <MenuItem Header="Pfeil"
                                      Click="AddArrow_Click"/>

                    </MenuItem>


                    <Separator/>


                    <MenuItem Header="Board">

                        <MenuItem Header="Board leeren"
                                      Click="ClearBoard_Click"/>

                        <MenuItem Header="Board zurücksetzen"
                                      Click="ResetBoard_Click"/>

                    </MenuItem>


                    <Separator/>


                    <MenuItem Header="Abbrechen"
                                  Click="CloseContextMenu_Click"/>

                </ContextMenu>

            </Canvas.ContextMenu>

        </Canvas>

    </Border>

    </DockPanel>
</Window>
