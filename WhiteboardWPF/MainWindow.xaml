<Window
    x:Class="WhiteboardWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WhiteboardWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.InputBindings>

        <!--
            ESC kann später zum Abbrechen einer Aktion
            verwendet werden.
        -->

        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />

    </Window.InputBindings>

    <DockPanel>

        <!--  =====================================================  -->
        <!--  Menü  -->
        <!--  =====================================================  -->

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Click="OnNewBoardClick"  Header="_Neu" />
                <Separator />
                <MenuItem Click="OnExitClick"  Header="_Beenden" />
            </MenuItem>


            <MenuItem Header="_Bearbeiten">

                <MenuItem Click="OnDeleteClick" Header="_Löschen" />

            </MenuItem>


            <MenuItem Header="_Ansicht">

                <MenuItem Click="OnResetBoardClick"  Header="_Whiteboard zurücksetzen" />

            </MenuItem>

        </Menu>


        <!--  =====================================================  -->
        <!--  Statusleiste  -->
        <!--  =====================================================  -->

        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem HorizontalContentAlignment="Right">

                <TextBlock Text="WhiteBoard" />

            </StatusBarItem>

        </StatusBar>


        <!--  =====================================================  -->
        <!--  Whiteboard  -->
        <!--  =====================================================  -->

        <Border
            Margin="8"
            Background="{StaticResource BoardBackgroundBrush}"
            BorderBrush="{StaticResource BoardBorderBrush}"
            BorderThickness="1">

            <!--
                Das Canvas ist die eigentliche Zeichenfläche.
                
                Wichtig:
                Wir verwenden bereits jetzt ein Canvas,
                weil später Shapes, Texte und Pfeile darauf
                positioniert werden.
            -->

            <Canvas
                x:Name="WhiteBoardCanvas"
                Background="{StaticResource BoardBackgroundBrush}"
                MouseRightButtonDown="OnWhiteBoardCanvasMouseRightButtonDown">

                <!--  =================================================  -->
                <!--  Contextmenü des Whiteboards  -->
                <!--  =================================================  -->

                <Canvas.ContextMenu>

                    <ContextMenu x:Name="WhiteBoardContextMenu" BorderBrush="{StaticResource MenuBorderBrush}">


                        <!--  Neue Elemente  -->
                        <MenuItem Header="Neues Element">

                            <MenuItem Click="OnAddShapeClick"  Header="Shape" />

                            <MenuItem Click="OnAddTextClick"  Header="Text" />

                            <MenuItem Click="OnAddArrowClick"  Header="Pfeil" />
                        </MenuItem>

                        <Separator />

                        <!--  Board  -->
                        <MenuItem Header="Board">
                            <MenuItem Click="OnClearBoardClick" Header="Board leeren" />
                            <MenuItem Click="OnResetBoardClick" Header="Board zurücksetzen" />
                        </MenuItem>

                        <Separator />

                        <MenuItem Click="OnCloseContextMenu" Header="Abbrechen" />

                    </ContextMenu>
                </Canvas.ContextMenu>
            </Canvas>
        </Border>
    </DockPanel>
</Window>
