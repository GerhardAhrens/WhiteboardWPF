<Window
    x:Class="WhiteboardWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WhiteboardWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--
            ESC kann später zum Abbrechen einer Aktion
            verwendet werden.
        -->

        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!--  =====================================================  -->
        <!--  Menü  -->
        <!--  =====================================================  -->

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_Datei">

                <MenuItem Click="NewBoard_Click" Header="_Neu" />

                <Separator />

                <MenuItem Click="Exit_Click" Header="_Beenden" />

            </MenuItem>


            <MenuItem Header="_Bearbeiten">

                <MenuItem Click="Delete_Click" Header="_Löschen" />

            </MenuItem>


            <MenuItem Header="_Ansicht">

                <MenuItem Click="ResetBoard_Click" Header="_Whiteboard zurücksetzen" />

            </MenuItem>

        </Menu>


        <!--  =====================================================  -->
        <!--  Statusleiste  -->
        <!--  =====================================================  -->

        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Whiteboard bereit" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem HorizontalContentAlignment="Right">

                <TextBlock Text="WhiteBoard" />

            </StatusBarItem>

        </StatusBar>


        <!--  =====================================================  -->
        <!--  Whiteboard  -->
        <!--  =====================================================  -->

        <Border
            Margin="8"
            Background="{StaticResource BoardBackgroundBrush}"
            BorderBrush="{StaticResource BoardBorderBrush}"
            BorderThickness="1">

            <Canvas
                x:Name="WhiteBoardCanvas"
                Background="{StaticResource BoardBackgroundBrush}"
                MouseLeftButtonDown="WhiteBoardCanvas_MouseLeftButtonDown"
                MouseRightButtonDown="WhiteBoardCanvas_MouseRightButtonDown">


                <!--  =================================================  -->
                <!--  Contextmenü  -->
                <!--  =================================================  -->

                <Canvas.ContextMenu>

                    <ContextMenu x:Name="WhiteBoardContextMenu" BorderBrush="{StaticResource MenuBorderBrush}">

                        <MenuItem Header="Neues Element">

                            <MenuItem Header="Shape">

                                <MenuItem Click="AddRectangle_Click" Header="Rechteck" />

                                <MenuItem Click="AddRoundedRectangle_Click" Header="Abgerundetes Rechteck" />

                                <MenuItem Click="AddEllipse_Click" Header="Ellipse" />

                                <MenuItem Click="AddDiamond_Click" Header="Raute" />

                            </MenuItem>

                            <MenuItem Click="AddText_Click" Header="Text" />

                            <MenuItem Click="AddArrow_Click" Header="Pfeil" />

                        </MenuItem>
                        
                        <Separator />


                        <MenuItem Header="Board">

                            <MenuItem Click="ClearBoard_Click" Header="Board leeren" />

                            <MenuItem Click="ResetBoard_Click" Header="Board zurücksetzen" />

                        </MenuItem>


                        <Separator />


                        <MenuItem Click="CloseContextMenu_Click" Header="Abbrechen" />

                    </ContextMenu>

                </Canvas.ContextMenu>

            </Canvas>

        </Border>

    </DockPanel>
</Window>
